rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNÇÕES AUXILIARES
    // O cargo e o status do usuário vêm do documento dele em "usuarios", encontrado pelo
    // vínculo com a conta de login: acessos/{uid}. O documento NÃO usa mais o e-mail como
    // chave, então o e-mail de login pode mudar sem perder cargo, áreas e vínculos.
    // Cada requisição lê no máximo 2 documentos (vínculo + usuário); o Firestore
    // reaproveita o resultado dentro da mesma requisição.
    // =====================================================================
    function logado() {
      return request.auth != null && request.auth.token.email != null;
    }

    function meuEmail() {
      return request.auth.token.email.lower();
    }

    function ehSuper() {
      return logado() && meuEmail() == 'leoignacio@gmail.com';
    }

    function meuId() {
      return get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.usuario_id;
    }

    function meuDoc() {
      return get(/databases/$(database)/documents/usuarios/$(meuId())).data;
    }

    function cargo() {
      return meuDoc().get('cargo', 'pendente');
    }

    // Só passa quem possui um dos cargos informados e NÃO está pendente/inativo/bloqueado
    // (mesmo critério do app: status ausente = ativo). Perde o acesso imediatamente ao ser desativado.
    function ehUm(lista) {
      return logado()
        && !(meuDoc().get('status', 'ativo') in ['pendente', 'inativo', 'bloqueado'])
        && cargo() in lista;
    }

    function ehGestor()      { return ehUm(['root', 'admin', 'tecnico']); }
    function ehAdmin()       { return ehUm(['root', 'admin']); }
    function ehOperacional() { return ehUm(['root', 'admin', 'tecnico', 'docente']); }
    function ehEquipe()      { return ehUm(['root', 'admin', 'tecnico', 'docente', 'apoio']); }

    function leituraEquipe()      { return ehSuper() || ehEquipe(); }
    function escritaOperacional() { return ehSuper() || ehOperacional(); }

    // Hierarquia usada pela interface de credenciamento.
    function rank(c) {
      return c == 'root' ? 5 : c == 'admin' ? 4 : c == 'tecnico' ? 3 : c == 'docente' ? 2 : c == 'apoio' ? 1 : 0;
    }

    // Somente Root e Admin gerenciam usuários (o técnico não acessa a coleção "usuarios").
    // Quem gerencia só altera usuários de nível inferior ao seu (root altera todos)
    // e só atribui cargos de nível inferior ao seu.
    function gestorPodeAlterar() {
      return ehAdmin()
        && (cargo() == 'root' || rank(cargo()) > rank(resource.data.get('cargo', 'pendente')))
        && (request.resource.data.get('cargo', 'pendente') == resource.data.get('cargo', 'pendente')
            || rank(request.resource.data.get('cargo', 'pendente')) < rank(cargo()));
    }

    function gestorPodeExcluir() {
      return ehAdmin()
        && (cargo() == 'root'
            ? resource.data.get('cargo', 'pendente') != 'root'
            : rank(cargo()) > rank(resource.data.get('cargo', 'pendente')));
    }

    // =====================================================================
    // USUÁRIOS
    // =====================================================================
    match /usuarios/{usuarioId} {

      // Titular = documento já vinculado à minha conta (campo "uid").
      function titular() {
        return logado() && resource.data.get('uid', '') == request.auth.uid;
      }
      // Cadastro ANTIGO (id = e-mail, ainda sem "uid"): é meu se o e-mail da conta de login conferir.
      // O primeiro acesso grava o "uid" e o vínculo, e a partir daí vale o campo "uid".
      function legadoMeu() {
        return logado() && !('uid' in resource.data)
          && (usuarioId == meuEmail() || resource.data.get('email', '').lower() == meuEmail());
      }

      // SEGURANÇA: somente Root/Admin leem a coleção inteira; cada pessoa lê apenas o PRÓPRIO documento.
      // Técnico, docente e apoio não listam usuários (a lista de docentes vem de "diretorio_docentes").
      allow read: if ehSuper()
        || titular()
        || legadoMeu()
        || ehAdmin();

      // Pré-cadastro: exige login, com o PRÓPRIO uid e e-mail e sempre como pendente.
      // O id do documento é livre (aleatório). Ninguém consegue se criar já como admin/root.
      allow create: if ehSuper()
        || (logado()
            && request.resource.data.get('uid', '') == request.auth.uid
            && request.resource.data.get('email', '').lower() == meuEmail()
            && request.resource.data.keys().hasOnly(['uid', 'nome', 'sobrenome', 'nome_completo', 'email',
                 'cargo_solicitado', 'solicitacao_credenciamento', 'cargo', 'perfis', 'areas', 'status', 'criado_em'])
            && request.resource.data.cargo == 'pendente'
            && request.resource.data.status == 'pendente'
            && request.resource.data.perfis == []
            && request.resource.data.areas == []);

      // O titular edita os próprios dados (nome, senha não passa por aqui, e-mail de login), mas NUNCA
      // cargo/perfis/áreas/status. O e-mail só pode ser igual ao da conta de login (comprovado pelo Firebase Auth).
      allow update: if ehSuper()
        || ((titular() || legadoMeu())
            && request.resource.data.get('uid', '') == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['cargo', 'perfis', 'areas', 'status', 'tipo_vinculo_area', 'credenciado_por', 'credenciado_em'])
            && (request.resource.data.get('email', '') == resource.data.get('email', '')
                || request.resource.data.get('email', '').lower() == meuEmail()))
        || gestorPodeAlterar();

      // O titular só exclui o próprio pré-cadastro enquanto estiver pendente.
      allow delete: if ehSuper()
        || ((titular() || legadoMeu()) && resource.data.status == 'pendente')
        || gestorPodeExcluir();
    }

    // Vínculo entre a conta de login (uid) e o documento do usuário. Só o PRÓPRIO usuário cria o seu e apenas para um
    // documento que já seja dele (campo "uid" igual, ou cadastro antigo com o mesmo e-mail). Imutável pelo usuário;
    // ele só o remove quando o documento apontado já não existe (ex.: pré-cadastro excluído).
    match /acessos/{uid} {
      function docAlvo() {
        return get(/databases/$(database)/documents/usuarios/$(request.resource.data.usuario_id)).data;
      }
      allow read: if ehSuper() || (logado() && request.auth.uid == uid) || ehAdmin();
      allow create: if ehSuper()
        || (logado() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['usuario_id', 'criado_em'])
            && (docAlvo().get('uid', '') == request.auth.uid
                || (!('uid' in docAlvo())
                    && (request.resource.data.usuario_id == meuEmail() || docAlvo().get('email', '').lower() == meuEmail()))));
      allow update: if ehSuper() || ehAdmin();
      allow delete: if ehSuper() || ehAdmin()
        || (logado() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/usuarios/$(resource.data.usuario_id)));
    }

    // Diretório público de docentes (nome, áreas e status; sem dados sensíveis). Toda a equipe lê;
    // somente Root/Admin gravam (o painel de credenciamento mantém o diretório sincronizado).
    match /diretorio_docentes/{emailId} {
      allow read: if leituraEquipe();
      allow write: if ehSuper() || ehAdmin();
    }

    // Diretório legado: pode conter campos extras; somente Admin/Root podem inspecionar ou limpar.
    match /diretorio_solicitacoes/{usuarioId} {
      allow read, write: if ehSuper() || ehAdmin();
    }

    // Diretório mínimo versionado, separado dos documentos legados.
    // A consulta list não usa resource.data.keys() como filtro: Firestore Rules não filtram resultados.
    // A proteção dos campos é garantida pelo esquema obrigatório em TODAS as gravações desta coleção.
    match /diretorio_solicitacoes_minimo/{usuarioId} {
      function camposDestinatarioMinimos(dados) {
        return dados.keys().hasAll(['uid', 'nome', 'cargo', 'status'])
          && dados.keys().hasOnly(['uid', 'nome', 'cargo', 'status']);
      }
      function registroProprioValido() {
        return ehEquipe()
          && usuarioId == meuId()
          && camposDestinatarioMinimos(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cargo == cargo()
          && request.resource.data.status == 'ativo'
          && (request.resource.data.nome == meuDoc().get('nome_completo', '')
              || request.resource.data.nome == meuDoc().get('nome', ''));
      }
      // O conteúdo continua mínimo porque Root/Admin também só podem gravar o esquema permitido.
      allow get, list: if leituraEquipe();
      allow create, update: if ((ehSuper() || ehAdmin()) && camposDestinatarioMinimos(request.resource.data))
        || registroProprioValido();
      allow delete: if ehSuper() || ehAdmin();
    }

    // Coleções legadas: só o titular lê; só o superusuário escreve.
    match /usuarios_permissoes/{emailId} {
      allow read: if ehSuper() || (logado() && meuEmail() == emailId);
      allow write: if ehSuper();
    }
    match /permissoes/{emailId} {
      allow read: if ehSuper() || (logado() && meuEmail() == emailId);
      allow write: if ehSuper();
    }

    // =====================================================================
    // DADOS OPERACIONAIS (leitura: toda a equipe ativa / escrita: operacional)
    // =====================================================================
    match /areas/{id} {
      allow read: if leituraEquipe();
      allow write: if escritaOperacional();
    }
    match /cursos/{id} {
      allow read: if leituraEquipe();
      allow write: if escritaOperacional();
    }
    match /ucs/{id} {
      allow read: if leituraEquipe();
      allow write: if escritaOperacional();
    }
    match /turmas/{id} {
      allow read: if leituraEquipe();
      allow write: if escritaOperacional();
    }

    // Encontros: o Apoio Técnico pode alterar SOMENTE os marcadores SS/SGO.
    match /encontros/{id} {
      allow read: if leituraEquipe();
      allow create, delete: if escritaOperacional();
      allow update: if escritaOperacional()
        || (ehUm(['apoio'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['SS', 'SGO', 'atualizado_em']));
    }

    // Calendário (exceções): somente Admin/Root gravam, como na interface.
    match /datas_excecoes/{id} {
      allow read: if leituraEquipe();
      allow write: if ehSuper() || ehAdmin();
    }

    // Recursos (salas): Admin/Root/Técnico gravam, como na interface.
    match /salas_aula/{id} {
      allow read: if leituraEquipe();
      allow write: if ehSuper() || ehGestor();
    }

    // =====================================================================
    // ÁREA DOCENTE
    // Escalas e férias são consultáveis pela equipe ativa. Só o titular docente
    // cria/encerra sua escala e administra seus períodos de férias.
    // Atividades e descrições são privadas ao docente e à equipe técnica/admin.
    // =====================================================================
    function proprioDocente(dados) {
      return ehUm(['docente'])
        && dados.get('docente_uid', '') == request.auth.uid
        && dados.get('docente_id', '') == meuId();
    }

    function podeLerAtividadeDocente(dados) {
      // UID é o único campo necessário na consulta do docente; os escritores
      // não podem alterar o vínculo UID/usuário validado por proprioDocente().
      return ehSuper() || ehUm(['root', 'admin', 'tecnico'])
        || (ehUm(['docente']) && dados.get('docente_uid', '') == request.auth.uid);
    }

    match /escalas_docentes/{id} {
      allow read: if leituraEquipe();
      allow create: if proprioDocente(request.resource.data)
        && request.resource.data.keys().hasOnly(['docente_uid', 'docente_id', 'docente_email', 'docente_nome', 'dias_semana', 'inicio_vigencia', 'final_vigencia', 'ch_semanal_minutos', 'criado_em', 'criado_por_email'])
        && request.resource.data.get('inicio_vigencia', '') is string
        && request.resource.data.get('final_vigencia', '') == 'Atual'
        && request.resource.data.get('dias_semana', {}) is map;
      // Única alteração permitida em um registro existente: encerrar sua vigência;
      // o docente não pode reescrever a grade histórica.
      allow update: if proprioDocente(resource.data)
        && proprioDocente(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['final_vigencia', 'encerrado_em', 'encerrado_por_email'])
        && request.resource.data.get('final_vigencia', '') is string
        && request.resource.data.get('final_vigencia', '') != 'Atual'
        && request.resource.data.get('final_vigencia', '') >= resource.data.get('inicio_vigencia', '');
      allow delete: if false;
    }

    match /ferias_docentes/{id} {
      allow read: if leituraEquipe();
      allow create: if proprioDocente(request.resource.data)
        && request.resource.data.keys().hasOnly(['docente_uid', 'docente_id', 'docente_email', 'docente_nome', 'periodo_aquisitivo', 'data_inicio', 'data_retorno', 'qtde_dias', 'criado_em', 'atualizado_em'])
        && request.resource.data.get('periodo_aquisitivo', '') is string
        && request.resource.data.get('periodo_aquisitivo', '').matches('^[0-9]{4}$')
        && request.resource.data.get('data_inicio', '') is string
        && request.resource.data.get('data_retorno', '') > request.resource.data.get('data_inicio', '')
        && request.resource.data.get('qtde_dias', 0) is int;
      allow update: if proprioDocente(resource.data)
        && proprioDocente(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['periodo_aquisitivo', 'data_inicio', 'data_retorno', 'qtde_dias', 'atualizado_em'])
        && request.resource.data.get('periodo_aquisitivo', '').matches('^[0-9]{4}$')
        && request.resource.data.get('data_retorno', '') > request.resource.data.get('data_inicio', '');
      allow delete: if proprioDocente(resource.data);
    }

    match /atividades_docentes/{id} {
      allow read: if podeLerAtividadeDocente(resource.data);
      allow create: if proprioDocente(request.resource.data)
        && request.resource.data.keys().hasOnly(['docente_uid', 'docente_id', 'docente_email', 'docente_nome', 'data', 'inicio', 'termino', 'tipo', 'descricao', 'criado_em', 'atualizado_em'])
        && request.resource.data.get('data', '') is string
        && request.resource.data.get('inicio', '') is string
        && request.resource.data.get('termino', '') > request.resource.data.get('inicio', '')
        && request.resource.data.get('tipo', '') == 'Outra Atividade'
        && request.resource.data.get('descricao', '') is string;
      allow update: if proprioDocente(resource.data)
        && proprioDocente(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'inicio', 'termino', 'tipo', 'descricao', 'atualizado_em'])
        && request.resource.data.get('termino', '') > request.resource.data.get('inicio', '')
        && request.resource.data.get('tipo', '') == 'Outra Atividade';
      allow delete: if proprioDocente(resource.data);
    }

    // =====================================================================
    // SOLICITAÇÕES DE HABILITAÇÃO EM OUTRAS ÁREAS
    // Qualquer membro ativo da equipe cria a PRÓPRIA solicitação (sempre pendente) e lê somente as suas;
    // Root/Admin leem todas e avaliam (aprovar/recusar).
    // =====================================================================
    match /solicitacoes_areas/{id} {
      allow read: if ehSuper() || ehAdmin() || (logado() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if ehSuper()
        || (ehEquipe()
            && request.resource.data.get('uid', '') == request.auth.uid
            && request.resource.data.status == 'Pendente'
            && request.resource.data.keys().hasOnly(['uid', 'usuario_id', 'email', 'nome', 'cargo', 'areas_solicitadas', 'justificativa', 'status', 'criado_em']));
      allow update: if ehSuper() || ehAdmin();
    }

    // =====================================================================
    // SOLICITAÇÕES ENTRE PERFIS (Dashboard)
    // O remetente acompanha apenas as próprias solicitações. Os perfis destinatários
    // podem ler e confirmar o processamento, ou devolver o estado para Pendente.
    // =====================================================================
    function solicitacaoDestinadaAoUsuario(dados) {
      return ehEquipe()
        && (dados.get('perfis_destino', []).hasAny([cargo()])
            || dados.get('destinatarios_uids', []).hasAny([request.auth.uid]));
    }

    match /solicitacoes/{id} {
      allow read: if ehSuper() || ehAdmin()
        || (logado() && resource.data.get('uid_solicitante', '') == request.auth.uid)
        || solicitacaoDestinadaAoUsuario(resource.data);

      allow create: if ehSuper()
        || (ehEquipe()
            && request.resource.data.keys().hasAll(['uid_solicitante', 'id_solicitante', 'email_solicitante', 'nome_solicitante', 'cargo_solicitante', 'perfis_destino', 'perfis_destino_individual', 'destinatarios_uids', 'tipo', 'area', 'assunto', 'mensagem', 'resposta_processamento', 'status', 'criado_em', 'processada_em', 'processada_por_uid', 'processada_por_email', 'processada_por_nome'])
            && request.resource.data.keys().hasOnly(['uid_solicitante', 'id_solicitante', 'email_solicitante', 'nome_solicitante', 'cargo_solicitante', 'perfis_destino', 'perfis_destino_individual', 'destinatarios_uids', 'tipo', 'area', 'assunto', 'mensagem', 'resposta_processamento', 'status', 'criado_em', 'processada_em', 'processada_por_uid', 'processada_por_email', 'processada_por_nome'])
            && request.resource.data.uid_solicitante == request.auth.uid
            && request.resource.data.id_solicitante == meuId()
            && request.resource.data.email_solicitante == meuEmail()
            && request.resource.data.cargo_solicitante == cargo()
            && request.resource.data.perfis_destino is list
            && request.resource.data.perfis_destino.size() <= 5
            && request.resource.data.perfis_destino.hasOnly(['root', 'admin', 'tecnico', 'docente', 'apoio'])
            && request.resource.data.perfis_destino_individual is list
            && request.resource.data.perfis_destino_individual.size() <= 5
            && request.resource.data.perfis_destino_individual.hasOnly(['root', 'admin', 'tecnico', 'docente', 'apoio'])
            && request.resource.data.destinatarios_uids is list
            && request.resource.data.destinatarios_uids.size() <= 50
            && (request.resource.data.perfis_destino.size() > 0 || request.resource.data.destinatarios_uids.size() > 0)
            && request.resource.data.resposta_processamento == ''
            && request.resource.data.tipo in ['area', 'problema', 'geral']
            && request.resource.data.status == 'Pendente'
            && request.resource.data.assunto is string
            && request.resource.data.assunto.size() > 0
            && request.resource.data.assunto.size() <= 120
            && request.resource.data.mensagem is string
            && request.resource.data.mensagem.size() > 0
            && request.resource.data.mensagem.size() <= 4000
            && request.resource.data.area is string
            && request.resource.data.area.size() <= 100
            && request.resource.data.processada_em == ''
            && request.resource.data.processada_por_uid == ''
            && request.resource.data.processada_por_email == ''
            && request.resource.data.processada_por_nome == ''
            && request.resource.data.resposta_processamento is string
            && request.resource.data.resposta_processamento.size() <= 2000);

      allow update: if (ehAdmin() || solicitacaoDestinadaAoUsuario(resource.data))
        && resource.data.get('uid_solicitante', '') != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processada_em', 'processada_por_uid', 'processada_por_email', 'processada_por_nome', 'resposta_processamento'])
        && ((resource.data.get('status', '') == 'Pendente'
              && request.resource.data.get('status', '') == 'Processada'
              && request.resource.data.get('processada_em', '') is string
              && request.resource.data.get('processada_por_uid', '') == request.auth.uid
              && request.resource.data.get('processada_por_email', '') == meuEmail()
              && request.resource.data.get('processada_por_nome', '') is string
              && request.resource.data.get('resposta_processamento', '') is string
              && request.resource.data.get('resposta_processamento', '').size() <= 2000)
            || (resource.data.get('status', '') == 'Processada'
              && request.resource.data.get('status', '') == 'Pendente'));

      allow delete: if false;
    }

    // =====================================================================
    // ALTERAÇÕES (lista do Apoio Técnico; "Alterações" tem acento, por isso a comparação por texto)
    // Toda a equipe LÊ. Quem altera dados cria registros. Apenas Apoio/Técnico/Admin/Root marcam SS/SGO
    // (campos de controle), sem poder editar o conteúdo do registro. Só é possível APAGAR registros pendentes e sem
    // SS/SGO marcado (limpeza de alterações duplicadas ou anuladas); o histórico já lançado nunca é apagado.
    // =====================================================================
    match /{colecao}/{id} {
      allow read: if colecao == 'Alterações' && leituraEquipe();
      allow create: if colecao == 'Alterações' && escritaOperacional();
      allow delete: if colecao == 'Alterações'
        && (ehSuper() || ehUm(['root', 'admin', 'tecnico', 'docente', 'apoio']))
        && resource.data.get('status', '') == 'Pendente'
        && resource.data.get('SS', false) == false
        && resource.data.get('SGO', false) == false;
      allow update: if colecao == 'Alterações'
        && (ehSuper() || ehUm(['root', 'admin', 'tecnico', 'apoio']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['SS', 'SGO', 'SS_ex', 'SGO_ex', 'status', 'realizado_em', 'realizado_por', 'realizado_por_nome']);
    }
  }
}
