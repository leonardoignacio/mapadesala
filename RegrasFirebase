rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == "leoignacio@gmail.com";
    }
    
    function getCargo() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email)) 
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.cargo 
        : (exists(/databases/$(database)/documents/usuarios_permissoes/$(request.auth.token.email)) 
          ? get(/databases/$(database)/documents/usuarios_permissoes/$(request.auth.token.email)).data.cargo 
          : 'pendente');
    }

    // Coleção de usuários: permite criar pré-cadastro e permite ao titular atualizar/excluir a própria solicitação
    match /usuarios/{emailId} {
      allow create: if true;
      allow read: if request.auth != null && (isSuperAdmin() || request.auth.token.email == emailId || getCargo() in ['root', 'admin', 'tecnico']);
      allow update, delete: if request.auth != null && (isSuperAdmin() || request.auth.token.email == emailId || getCargo() in ['root', 'admin', 'tecnico']);
    }

    match /usuarios_permissoes/{emailId} {
      allow read, write: if isSuperAdmin();
      allow read: if request.auth != null && request.auth.token.email == emailId;
    }

    match /{document=**} {
      allow read: if request.auth != null && (isSuperAdmin() || getCargo() in ['root', 'admin', 'tecnico', 'docente', 'apoio']);
      allow write: if request.auth != null && (isSuperAdmin() || getCargo() in ['root', 'admin', 'tecnico', 'docente']);
    }
  }
}